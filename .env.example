# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# dbt analytics (Postgres connection from Supabase Dashboard -> Connect)
DBT_HOST=
DBT_PORT=5432
DBT_USER=
DBT_PASSWORD=
DBT_DBNAME=postgres
DBT_THREADS=4
DBT_SSLMODE=require

# Provider integrations
# API-Football is the first Data Phase 2 provider.
API_FOOTBALL_API_KEY=
# Optional single target; do not duplicate a league also present in API_FOOTBALL_PLAYERS_URLS.
API_FOOTBALL_PLAYERS_URL=
# Full Big Five target set (39, 140, 135, 78, 61), comma- or newline-separated.
API_FOOTBALL_PLAYERS_URLS=https://v3.football.api-sports.io/players?league=39&season=2024,https://v3.football.api-sports.io/players?league=140&season=2024,https://v3.football.api-sports.io/players?league=135&season=2024,https://v3.football.api-sports.io/players?league=78&season=2024,https://v3.football.api-sports.io/players?league=61&season=2024
API_FOOTBALL_MAX_PAGES_PER_TARGET=60

# Future provider candidates
FOOTIO_API_KEY=

# Scheduling/observability
CRON_SECRET=your-cron-secret
PERF_REVIEW_SECRET=
REFRESH_STALE_AFTER_HOURS=36
LOG_LEVEL=info

# Performance acceptance (50 measured search + 50 measured recommendation requests by default)
PERF_SEARCH_QUERY=salah
PERF_TARGET_NAME=Mohamed Salah
PERF_TARGET_PROVIDER_SOURCE=
# Optional when name + provider source are unique; requires PERF_TARGET_PROVIDER_SOURCE when set.
PERF_TARGET_PROVIDER_PLAYER_ID=
PERF_WARMUPS=3
PERF_ITERATIONS=50
# Pacing stays below the public 60/min search and 20/min recommendation limits.
PERF_SEARCH_INTERVAL_MS=1250
PERF_RECOMMEND_INTERVAL_MS=3100
PERF_SEARCH_P95_MS=1000
PERF_RECOMMEND_P95_MS=2000

# API-Football volume audit
AUDIT_MODE=full
# Set this to a prior audit's contentChecksum to enforce repeat-run stability.
AUDIT_EXPECTED_CONTENT_CHECKSUM=

# Smoke target identity (required when the target name is ambiguous across providers)
SMOKE_SEARCH_QUERY=salah
SMOKE_TARGET_NAME=Mohamed Salah
SMOKE_TARGET_PROVIDER_SOURCE=
SMOKE_TARGET_PROVIDER_PLAYER_ID=
E2E_SEARCH_QUERY=salah
E2E_TARGET_NAME=Mohamed Salah
E2E_TARGET_PROVIDER_SOURCE=seed
E2E_TARGET_PROVIDER_PLAYER_ID=seed-mohamed-salah
